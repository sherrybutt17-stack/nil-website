{
  "name": "nil-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:night": "NEXT_PUBLIC_SITE_VARIANT=night next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "build:flare": "NEXT_PUBLIC_SITE_VARIANT=flare NEXT_DIST_DIR=.next-flare next build",
    "build:night": "NEXT_PUBLIC_SITE_VARIANT=night NEXT_DIST_DIR=.next-night next build",
    "build:both": "npm run build:flare && npm run build:night",
    "start:flare": "NEXT_DIST_DIR=.next-flare next start -p 3000",
    "start:night": "NEXT_DIST_DIR=.next-night next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "motion": "14.7",
    "next": "16.4",
    "radix-ui": "^1.8.1",
    "react": "19.3",
    "react-dom": "19.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4",
    "tailwindcss": "4.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
