# Public origin used for canonical URLs, Open Graph images, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where form submissions are delivered (server-side only — never exposed to the browser).
# Any endpoint that accepts a JSON POST: Zapier/Make/n8n webhook, Google Apps Script web app, your API…
# Leave unset and the forms will tell visitors their details were NOT sent.
INQUIRY_WEBHOOK_URL=

# Optional per-form overrides (take priority over INQUIRY_WEBHOOK_URL).
INQUIRY_WEBHOOK_URL_ATHLETE=
INQUIRY_WEBHOOK_URL_AGENCY=
INQUIRY_WEBHOOK_URL_CONTACT=

# Optional shared secret, sent as "Authorization: Bearer <secret>" so your endpoint can reject other callers.
INQUIRY_WEBHOOK_SECRET=
